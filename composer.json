{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "aws/aws-sdk-php": "^3.356",
        "barryvdh/laravel-dompdf": "^3.1",
        "barryvdh/laravel-translation-manager": "^0.6.8",
        "cviebrock/eloquent-sluggable": "^11.0",
        "doctrine/dbal": "^4.3",
        "elasticsearch/elasticsearch": "^7.17",
        "erag/laravel-disposable-email": "^4.0",
        "firebase/php-jwt": "^6.11",
        "froiden/envato": "^5.1",
        "froiden/laravel-installer": "^11.0",
        "froiden/laravel-rest-api": "^11.0",
        "guzzlehttp/guzzle": "^7.10",
        "intervention/image": "^3.11",
        "ixudra/curl": "^6.22",
        "laravel/cashier": "^16.0",
        "laravel/cashier-paddle": "^2.6",
        "laravel/framework": "^11.31",
        "laravel/helpers": "^1.8",
        "laravel/horizon": "^5.44",
        "laravel/octane": "^2.15",
        "laravel/reverb": "^1.0",
        "laravel/scout": "^10.19",
        "laravel/socialite": "^5.23",
        "laravel/tinker": "^2.9",
        "league/flysystem": "^3.30",
        "league/flysystem-aws-s3-v3": "^3.29",
        "maatwebsite/excel": "^3.1",
        "macellan/laravel-zip": "^1.0",
        "nwidart/laravel-modules": "^12.0",
        "php-http/guzzle7-adapter": "^1.1",
        "phpmailer/phpmailer": "^6.11",
        "phpoffice/phpword": "^1.4",
        "predis/predis": "^3.4",
        "razorpay/razorpay": "^2.9",
        "smalot/pdfparser": "^2.12",
        "spatie/laravel-permission": "^6.21",
        "stripe/stripe-php": "^17.6",
        "tymon/jwt-auth": "^2.3",
        "yajra/laravel-datatables-buttons": "^11",
        "yajra/laravel-datatables-html": "^11",
        "yajra/laravel-datatables-oracle": "^11"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/breeze": "^2.3",
        "laravel/pail": "^1.1",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11.0.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": ["app/Helper/start.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
